generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Rol {
  Visitante
  UsuarioRegistrado
  PortadorConocimiento
  EspecialistaAgronomo
  EspecialistaConservacion
  EspecialistaSalud
  Productor
  Administrador
}
enum EstadoValidacion {
  Pendiente
  EnRevision
  Validado
  Observado
  Rechazado
}
enum EstadoCuenta {
  PendienteActivacion
  Activo
  Suspendido
}
enum EstadoReporte {
  Pendiente
  Revisado
  Desestimado
}
enum TipoTokenAccion {
  Activacion
  RecuperacionContrasena
}
enum TipoConsulta {
  PreguntaGeneral
  ReporteInformacionIncorrecta
  SolicitudRevisionPublicacion
  SolicitudValidacionInformacion
  ReportePlantaEnPeligro
  ReporteProblemaCultivo
  ConsultaSobrePublicacion
}
enum EstadoConsulta {
  Pendiente
  EnRevision
  Respondida
  Cerrada
}
enum PrioridadConsulta {
  Normal
  Alta
}
enum AreaEspecialidad {
  Agronomia
  PlantasMedicinales
  Conservacion
  Salud
}
model Usuario {
  id String @id @default(uuid())
  nombre String
  correo String @unique
  contraseñaHash String
  rol Rol
  idioma String
  nivelConocimiento String
  region String
  estado EstadoCuenta
  // Frente 3 (comisión del 5%): se pide "asociada al producto o al perfil, la primera vez" -- se
  // eligió el perfil: se registra una sola vez (booleano derivado de que esta fecha no sea null) y
  // cubre todas las publicaciones futuras, en vez de repetir el mismo checkbox en cada producto.
  aceptoComisionEn DateTime?
  // Perfil (campos básicos): teléfono, presentación breve y, para Productor, nombre de su negocio.
  telefono String?
  biografia String?
  nombreNegocio String?
  // Ronda 18: tipo de cuenta aprobado por un administrador (Productor / Empresario / Institucion). Null = cuenta normal.
  tipoCuenta String?
  // Ronda 30: el productor se marca "disponible para contacto ahora" hasta esta fecha (vence solo a los 7 días si no lo renueva).
  disponibleHasta DateTime?
  disponibleNota String?
  solicitudesCuenta SolicitudCuenta[]
  cultivos Cultivo[]
  validaciones ValidacionContenido[]
  notificaciones Notificacion[]
  tokensAccion TokenAccion[]
  reportes Reporte[]
  publicaciones Publicacion[]
  preparaciones Preparacion[]
  productos Producto[]
  estadosConservacion EstadoConservacion[]
  accionesConservacion AccionConservacion[]
  ubicacionesCultivo UbicacionCultivo[]
}
model TokenAccion {
  id String @id @default(uuid())
  usuarioId String
  tipo TipoTokenAccion
  token String @unique
  expiracion DateTime
  usado Boolean @default(false)
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}
model Planta {
  id String @id @default(uuid())
  nombreComun String
  nombreCientifico String
  familia String
  region String
  habitat String
  imagenPrincipal String?
  // Atribución de la foto (Ronda 29): autor, licencia y página de origen; se muestran junto a la imagen en la ficha.
  imagenAutor String?
  imagenLicencia String?
  imagenFuenteUrl String?
  // Distribución natural documentada (Kew POWO), a nivel de país/región: [{zona,lat,lng}]. Alimenta la 2.ª capa del mapa de cultivos; no es una ubicación de cultivo.
  distribucionNatural Json?
  // Ubicación de observación (GPS/mapa al proponer). Nunca se expone en el catálogo público (RN-07: la
  // ubicación exacta de una planta puede ponerla en riesgo); solo la ve quien valida.
  latitud Float?
  longitud Float?
  // Frente 4 (auditoría): "Proponer planta" no existía en ningún rol -- las plantas solo se podían
  // crear directo (POST /plantas, requireValidator) sin pasar por M-09. @default(Validado) hace
  // que TODAS las plantas ya existentes en la base queden exactamente igual de visibles que hoy
  // (nada cambia para ellas); solo las propuestas nuevas (ProponerPlantaUseCase) arrancan Pendiente.
  estadoValidacion EstadoValidacion @default(Validado)
  cultivos Cultivo[]
  partesUso ParteUso[]
  publicaciones Publicacion[]
  estadosConservacion EstadoConservacion[]
  accionesConservacion AccionConservacion[]
  ubicacionesCultivo UbicacionCultivo[]
}
model Cultivo {
  id String @id @default(uuid())
  plantaId String
  autorId String
  zonaCultivo String
  condicionesClimaticas String
  tipoSuelo String
  altitudAprox String
  aguaNecesaria String
  exposicionSolar String
  epocaSiembra String
  metodoPropagacion String
  tiempoCrecimiento String
  cuidados String
  plagasComunes String
  epocaCosecha String
  recomendacionesSobreexplotacion String
  consejosRecoleccion String
  mesesSiembra Int[]
  mesesCosecha Int[]
  fuente String
  // Ronda 19: guía para quien quiera sembrar. La escribe SOLO un especialista en agronomía (o un administrador);
  // nace vacía y NUNCA se rellena por el sistema: vacío = pendiente de un especialista.
  // Ronda 22: la guía es un JSON con las secciones de CAMPOS_GUIA (suelo, pH, drenaje, nutrientes, calendario, riego, clima, plagas...).
  guia Json?
  guiaEspecialistaId String?
  guiaActualizadaEn DateTime?
  estadoValidacion EstadoValidacion
  planta Planta @relation(fields: [plantaId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
  ubicaciones UbicacionCultivo[]
}
model Uso {
  id String @id @default(uuid())
  nombre String @unique
  descripcion String?
  partesUso ParteUso[]
}
model ParteUso {
  id String @id @default(uuid())
  plantaId String
  autorId String
  parte String
  usoId String
  tipoConocimiento String
  preparacionId String?
  contraindicaciones String?
  // Por qué/para qué se usa (texto de quien lo propone) y, si parte='Otra', cuál es.
  motivoUso String?
  parteDetalle String?
  // Nota interna (nunca pública) y evidencia de la validación científica de un uso tradicional.
  contactoSeguimiento String?
  valCientEspecialista String?
  valCientFecha DateTime?
  valCientEvidencia String?
  valCientEnlace String?
  valCientRegistradaPorId String?
  valCientRegistradaEn DateTime?
  fuente String
  estadoValidacion EstadoValidacion
  planta Planta @relation(fields: [plantaId], references: [id])
  uso Uso @relation(fields: [usoId], references: [id])
  preparaciones Preparacion[]
}
model Preparacion {
  id String @id @default(uuid())
  parteUsoId String
  autorId String
  ingredientes String
  pasos String
  herramientas String
  tiempoPreparacion String
  formaTradicionalElaboracion String
  formaConservacion String
  advertencias String
  contraindicaciones String?
  fuente String
  localidad String
  fecha DateTime
  estadoValidacion EstadoValidacion
  parteUso ParteUso @relation(fields: [parteUsoId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
}
model Publicacion {
  id String @id @default(uuid())
  plantaId String
  autorId String
  nombreComun String
  descripcion String
  enfermedadesTratadas String
  formaPreparacion String
  imagenes String[]
  tipoConocimiento String
  fuente String
  fechaPublicacion DateTime
  estadoValidacion EstadoValidacion
  planta Planta @relation(fields: [plantaId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
  comentarios Comentario[]
  valoraciones Valoracion[]
}
model Comentario {
  id String @id @default(uuid())
  publicacionId String
  autorId String
  texto String
  fecha DateTime
  comentarioPadreId String?
  publicacion Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  comentarioPadre Comentario? @relation("RespuestasComentario", fields: [comentarioPadreId], references: [id])
  respuestas Comentario[] @relation("RespuestasComentario")
}
model Valoracion {
  id String @id @default(uuid())
  publicacionId String
  autorId String
  estrellas Int
  publicacion Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  @@unique([publicacionId, autorId])
}
// M-15 · Contacto pagado y planes. Un registro = un pago con comprobante (Yape/Plin) que un administrador
// confirma o rechaza. concepto='Plan' (Negocio/Institucional, con vencimiento; el histórico 'Destacado' ya no se ofrece) o 'Desbloqueo'
// (contacto puntual de UN productor). El "plan activo" y el estado Vencido se DERIVAN de estos registros
// (Confirmado + vigenteHasta), no se guardan aparte: nada queda "activo" por olvido de un cron.
model PagoContacto {
  id String @id @default(uuid())
  usuarioId String
  concepto String
  plan String?
  productorId String?
  monto Float
  metodo String
  numeroOperacion String?
  comprobanteUrl String
  estado String
  creadoEn DateTime
  revisadoPorId String?
  revisadoEn DateTime?
  motivoRechazo String?
  vigenteDesde DateTime?
  vigenteHasta DateTime?

  @@index([usuarioId])
  @@index([estado])
}
model Consulta {
  id String @id @default(uuid())
  autorId String?
  tipo TipoConsulta
  descripcion String
  estado EstadoConsulta
  prioridad PrioridadConsulta
  areaAsignada AreaEspecialidad?
  asignadoA String?
  fechaCreacion DateTime
  fechaActualizacion DateTime
  fechaPrimeraRespuestaEquipo DateTime?
  // Fotos y ubicación opcionales (gratis, sin depender de ningún plan).
  imagenes String[] @default([])
  latitud Float?
  longitud Float?
  mensajes MensajeConsulta[]
  // Ronda 22: consulta hecha por alguien con plan Institucional vigente al momento de enviarla (soporte prioritario).
  prioritaria Boolean @default(false)
}
model MensajeConsulta {
  id String @id @default(uuid())
  consultaId String
  autorId String
  contenido String
  esEquipo Boolean @default(false)
  fecha DateTime
  consulta Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
}
model ValidacionContenido {
  id String @id @default(uuid())
  tipoEntidad String
  entidadId String
  estado EstadoValidacion
  comentarioValidador String?
  fecha DateTime
  autorId String
  validadorId String?
  validador Usuario @relation(fields: [autorId], references: [id])
}
model Reporte {
  id String @id @default(uuid())
  tipoEntidad String
  entidadId String
  autorId String
  motivo String
  categoria String @default("Otro")
  fecha DateTime
  estado EstadoReporte
  autor Usuario @relation(fields: [autorId], references: [id])
}
model EstadoConservacion {
  id String @id @default(uuid())
  plantaId String
  autorId String
  categoria String
  zona String
  amenazas String
  nivelRiesgo String
  disponibilidadTemporada String
  recomendacionesConservacion String
  metodosPropagacion String
  alternativasCultivo String
  fuenteOficial String
  fecha DateTime
  estadoValidacion EstadoValidacion
  planta Planta @relation(fields: [plantaId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
}
model AccionConservacion {
  id String @id @default(uuid())
  plantaId String
  autorId String
  descripcion String
  responsable String
  evidencias String
  estadoSeguimiento String
  fecha DateTime
  planta Planta @relation(fields: [plantaId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
}
// RF-271: mapa de distribución. RN-07 -- latitud/longitud son opcionales y quedan en null cuando
// la planta está en riesgo (aplicado en el caso de uso, nunca a nivel de columna obligatoria).
model UbicacionCultivo {
  id String @id @default(uuid())
  cultivoId String
  plantaId String
  autorId String
  zona String
  latitud Float?
  longitud Float?
  fecha DateTime
  cultivo Cultivo @relation(fields: [cultivoId], references: [id])
  planta Planta @relation(fields: [plantaId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])
}
model Producto {
  id String @id @default(uuid())
  productorId String
  nombre String
  descripcion String?
  plantasIds String[]
  // Frente 3: entrada estructurada (planta/parte usada/estado/cantidad) por cada uso de planta en
  // el producto -- reemplaza los checkboxes de una lista fija. Json porque es una lista de objetos
  // heterogénea (cantidad/unidad opcionales, plantaId opcional cuando no hubo match con el
  // catálogo) sin necesidad propia de consultarse por columna; plantasIds se sigue derivando
  // automáticamente de acá (ver PublicarProductoUseCase) así que ningún consumidor existente
  // (ProductoCard, filtros por plantaId) se entera del cambio.
  plantasUtilizadas Json?
  ingredientes String?
  presentacion String?
  cantidad String?
  precioReferencial String?
  fotografias String[]
  localidad String
  // Frente 6 (mini-mapa por producto): el selector de mapa de Frente 3 (SelectorUbicacionMapa) ya
  // capturaba lat/lon del pin, pero solo se usaban para geocodificación inversa (rellenar el texto
  // de `localidad`) y se descartaban -- nunca se guardaban. Opcionales porque `localidad` sigue
  // siendo un input de texto editable a mano (no derivado exclusivamente del mapa): un producto
  // publicado sin tocar el mapa, o publicado antes de este cambio, no tiene coordenadas.
  latitud Float?
  longitud Float?
  informacionProceso String
  fechaElaboracion DateTime?
  // Ronda 18: quién produce y para qué sirve / cómo se usa (todo lo declara el productor; vacío = no especificado).
  tipoProductor String?
  categoriasUso String[] @default([])
  modoDeUso String?
  contraindicaciones String?
  contactoVendedor String
  documentacionCertificacion String?
  requiereRevisionReforzada Boolean @default(false)
  etiquetaValidadoDocumental Boolean @default(false)
  etiquetaCertificado Boolean @default(false)
  estadoValidacion EstadoValidacion
  productor Usuario @relation(fields: [productorId], references: [id])
}
// Ronda 18: solicitud de cambio de tipo de cuenta; se decide en la bandeja de validación (M-09), solo Administrador.
model SolicitudCuenta {
  id String @id @default(uuid())
  usuarioId String
  tipoSolicitado String
  nombreOrganizacion String?
  descripcion String
  identificacion String?
  sitioWeb String?
  estadoValidacion EstadoValidacion
  creadaEn DateTime
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}
model Notificacion {
  id String @id @default(uuid())
  usuarioId String
  tipo String
  mensaje String
  leida Boolean
  fecha DateTime
  entidadTipo String?
  entidadId String?
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

// Ronda 30 (plan Negocio): mensajería directa comprador (con plan) <-> productor contactable. Una conversación por par.
model Conversacion {
  id String @id @default(uuid())
  compradorId String
  productorId String
  creadaEn DateTime @default(now())
  actualizadaEn DateTime @default(now())
  mensajes MensajeDirecto[]
  @@unique([compradorId, productorId])
}
model MensajeDirecto {
  id String @id @default(uuid())
  conversacionId String
  autorId String
  texto String
  creadoEn DateTime @default(now())
  leidoEn DateTime?
  conversacion Conversacion @relation(fields: [conversacionId], references: [id])
}
// Ronda 30 (plan Negocio): alertas de disponibilidad (hay productos aprobados con la planta) y de temporada (mes de cosecha de una ficha validada).
model AlertaSeguimiento {
  id String @id @default(uuid())
  usuarioId String
  plantaId String
  disponibilidad Boolean @default(true)
  temporada Boolean @default(true)
  productosNotificados String[] @default([])
  ultimaTemporada String?
  creadoEn DateTime @default(now())
  @@unique([usuarioId, plantaId])
}
// Ronda 30 (plan Institucional): registro ANÓNIMO de búsquedas por nombre (solo la planta y la fecha; sin usuario ni texto) para el reporte de plantas más buscadas.
model BusquedaPlanta {
  id String @id @default(uuid())
  plantaId String
  fecha DateTime @default(now())
}
