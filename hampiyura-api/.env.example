# Copia este archivo a `.env` (cp .env.example .env) y ajusta los valores.
# NUNCA subas el `.env` real al repositorio: está en .gitignore.

# --- Base de datos (PostgreSQL 14+) ---------------------------------------------------------
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Con el docker-compose.yml de la raíz coincide con los valores por defecto de abajo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hampiyura"

# --- Seguridad -------------------------------------------------------------------------------
# Secreto con el que se firman los tokens de sesión (JWT, 1 día de vigencia).
# En PRODUCCIÓN es obligatorio y el servidor se niega a arrancar sin uno real (>= 32 caracteres).
# Genera uno con:   openssl rand -hex 32
JWT_SECRET="replace-with-a-local-secret"

# Poné NODE_ENV=production en el servidor real (activa la validación de JWT_SECRET).
# NODE_ENV=production

# --- Servidor --------------------------------------------------------------------------------
PORT=3000

# --- Solo para `npm run seed` (opcionales) ---------------------------------------------------
# Cuenta Administrador inicial. Sin ella nadie puede validar contenido en la app (el rol no se
# puede autoasignar desde la interfaz). Mínimo 8 caracteres, con letras y números.
# Puedes borrar estas dos líneas del .env después de correr el seed.
# SEED_ADMIN_CORREO="admin@tu-dominio.com"
# SEED_ADMIN_PASSWORD="cambia-esto-por-una-clave-segura-123"
# SEED_ADMIN_NOMBRE="Administrador"

# Solo desarrollo local: agrega 2 plantas "[DATO DE PRUEBA]" al catálogo. No lo actives en producción.
# SEED_DATOS_DE_PRUEBA=true
