# Configuración para `docker compose up -d` (raíz del repo). Copia este archivo:  cp .env.example .env
# El .env real NUNCA se sube a git. Para desarrollo SIN Docker usa hampiyura-api/.env.example.

# --- Puertos publicados en tu máquina -------------------------------------------------------
WEB_PORT=8080          # la aplicación: http://localhost:8080
API_PORT=3000          # la API directa (opcional): http://localhost:3000/api/plantas
POSTGRES_PORT=5432     # la BD, solo accesible desde tu propia máquina (127.0.0.1)

# --- Base de datos ---------------------------------------------------------------------------
# Si expones esto a internet, CAMBIA la contraseña (letras y números; sin @ : / ? # para no romper la URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hampiyura

# --- Seguridad -------------------------------------------------------------------------------
# Déjalo vacío: la API genera un secreto aleatorio la primera vez y lo guarda en un volumen.
# Si prefieres fijarlo tú:  openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=

# --- Datos iniciales (seed, idempotente: corre solo en cada arranque) ------------------------
# Cuenta Administrador para entrar y moderar. DEMOSTRACIÓN: cambia la clave si esto será público.
SEED_ADMIN_CORREO=admin@hampiyura.local
SEED_ADMIN_PASSWORD=HampiYura2026Demo
SEED_ADMIN_NOMBRE=Administrador
# true = agrega 2 plantas "[DATO DE PRUEBA]" además del catálogo base. Ponlo en false en un servidor real.
SEED_DATOS_DE_PRUEBA=true

# --- M-15 (pago de contacto): sin número real la pantalla avisa "por configurar" (modo demostración) ---
PAGO_YAPE_NUMERO=
PAGO_YAPE_TITULAR=HampiYura
PAGO_PLIN_NUMERO=
PAGO_PLIN_TITULAR=HampiYura
