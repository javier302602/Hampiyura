# Ejemplo de nginx para servir HampiYura en producción.
#
#   - El frontend es estático: es el contenido de hampiyura-web/dist (resultado de `npm run build`).
#     nginx lo sirve directamente desde ahí, así que no necesita gestor de procesos y sobrevive a
#     reinicios como cualquier servicio de systemd (nginx se habilita solo al instalarlo con apt).
#   - /api y /uploads se reenvían al backend Node (puerto 3000 por defecto).
#
# Copia este archivo a /etc/nginx/conf.d/hampiyura.conf (o sites-available), ajusta `server_name` y
# `root`, y recarga nginx. Para HTTPS usa certbot (https://certbot.eff.org), que edita este bloque.
server {
    listen 80;
    server_name tu-dominio.com;

    root /opt/hampiyura/hampiyura-web/dist;   # <- salida de `npm run build`; se actualiza sola con cada build
    index index.html;

    # El backend acepta imágenes en base64 dentro de JSON (hasta 8 MB): deja margen.
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    # SPA (React Router): cualquier ruta que no sea un archivo devuelve index.html.
    location / {
        try_files $uri /index.html;
    }
}
